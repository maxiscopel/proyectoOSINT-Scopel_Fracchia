        "jsCode": "const rows = items.map((i) => i.json);\nconst inserted = rows.filter((r) => r.inserted === true).length;\nreturn [{ json: { ok: true, mode: 'n8n-webhook', fetched: rows.length, inserted, updated: rows.length - inserted,\n  detail: `Sincronizacion en n8n: ${rows.length} registros procesados, ${inserted} altas nuevas` } }];"
