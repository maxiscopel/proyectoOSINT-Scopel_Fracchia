    {
      "parameters": {
        "jsCode": "const raw = (items[0].json.stdout || '').trim();\nlet r;\ntry { r = JSON.parse(raw); } catch (e) { return [{ json: { _empty: true, ok: false, reason: 'invalid_output', detail: raw.slice(0, 300) } }]; }\nif (!r.ok || !Array.isArray(r.records) || r.records.length === 0) {\n  return [{ json: { _empty: true, ok: false, reason: r.reason || 'no_records', errors: r.errors || [] } }];\n}\nreturn r.records.map((x) => ({ json: {\n  post_id: String(x.post_id).slice(0, 300), title: String(x.title).slice(0, 500),\n  content: x.content != null ? String(x.content).slice(0, 10000) : '',\n  raw_content: x.raw_content != null ? String(x.raw_content).slice(0, 10000) : '',\n  author: String(x.author || 'reddit'), subreddit: String(x.subreddit || ''), url: x.url != null ? String(x.url) : '',\n  score: Number(x.score) || 0, num_comments: Number(x.num_comments) || 0,\n  threat_category: String(x.threat_category || 'no_clasificado'), sentiment: String(x.sentiment || 'neutral'),\n  compound: Number(x.compound) || 0, created_utc: x.created_utc ? String(x.created_utc) : null,\n  source: String(x.source || 'reddit-rss'),\n} }));"
      },
